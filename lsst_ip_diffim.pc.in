prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib
doxygen_tag=${prefix}/doc/ip_diffim.tag
lsst_build_requires=boost_timer pybind11 python3

Name: lsst_ip_diffim
Description: LSST Science Pipelines image differencing
Version: @VERSION@
Requires: lsst_meas_base lsst_afw numpy minuit2 lsst_log lsst_daf_base
Cflags: -I${includedir}
Libs: -L${libdir} -lip_diffim
